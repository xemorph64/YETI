  "hero.line1": {
    "en": "India has been going to the ice since 1981.",
    "hi": "1981 से भारत बर्फ़ की दुनिया में जा रहा है।",
    "bn": "১৯৮১ সাল থেকে ভারত বরফের দুনিয়ায় যাচ্ছে।"
  },
  "hero.line2": {
    "en": "Almost no one has seen it.",
    "hi": "बहुत कम लोगों ने इसे देखा है।",
    "bn": "প্রায় কেউ এটি দেখেনি।"
  },
  "hero.line3": {
    "en": "Until now.",
    "hi": "अब तक।",
    "bn": "এখন আর নয়।"
  },
  "hero.sub": {
    "en": "45 years of Indian polar expeditions, data, imagery and stories — one window, open to everyone.",
    "hi": "भारतीय ध्रुवीय अभियानों के 45 साल — डेटा, तस्वीरें और कहानियाँ, एक खिड़की में, सबके लिए खुली।",
    "bn": "ভারতীয় মেরু অভিযানের ৪৫ বছর — ডেটা, ছবি ও গল্প, এক জানালায়, সবার জন্য উন্মুক্ত।"
